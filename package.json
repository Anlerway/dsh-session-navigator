{
  "name": "dsh-session-navigator",
  "version": "1.1.3",
  "description": "会话资源管理器 (Session Navigator) for DeepSeek Harness: virtual folders, tags, notes, trash and multi-workspace session browsing on top of the native DSH session store.",
  "type": "module",
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "icon": "./assets/icon.png",
  "scripts": {
    "pretest": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "test:render": "node test/render-smoke.mjs",
    "lint": "node scripts/lint.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "prepack": "node scripts/build-client.mjs && node scripts/sync-notes.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "!lib/client-src/",
    "assets/",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "locale/"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "navigator",
    "explorer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anlerway/dsh-session-navigator.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5 || >=4.0.5-alpha.1 <5",
    "koffi": "^3.3.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "koffi": {
      "optional": true
    }
  }
}

# The only runtime dependency is koffi (a prebuilt Node-API binding for the
# Windows shell reveal); it is installed next to the plugin, never committed.
node_modules/

# The client bundle is generated from src/client/ by scripts/build-client.mjs, and
# it is committed: a clone or a git-installed copy then has a working panel without
# a build step. It stays generated — edit the fragments, run `pnpm build:client`,
# and commit the result. `pnpm test` carries the bundle-drift case and
# `pnpm check:client` names the first byte that drifted, so a stale bundle fails
# instead of shipping.

# Scratch space. Anything that is not the plugin itself belongs outside the
# repository (see ../project_old for the archived material).
temp/
tmp/
*.log

# dsh-ops drops a lock file next to every file it touches; they are not ours.
.dsh-ops-update-*.lock

# Editor and OS noise.
.DS_Store
Thumbs.db
.vscode/
.idea/

# The plugin's own sidecar data directory, when someone points DSH_SE_DATA_DIR
# at the checkout while debugging.
.dsh-session-explorer/
